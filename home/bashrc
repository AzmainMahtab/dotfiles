#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias cd='z'
alias ls='exa -l'

# Plain ssh with a universally known TERM; kitten ssh's remote bootstrap and
# xterm-kitty keyboard protocol garble pasted passwords at sudo prompts.
alias ssh='TERM=xterm-256color ssh'

PS1='[\u@\h \W]\$ '
export PATH="$HOME/.local/bin:$PATH"

# CC Analytics — Claude Code team analytics (shim disabled: it drops all CLI args,
# breaking `claude --resume`/`-c`/etc. Hooks in ~/.claude/settings.json use absolute
# paths and still work.)

# opencode
export PATH=$HOME/.opencode/bin:$PATH

# NVM (node version manager)
source /usr/share/nvm/init-nvm.sh

. "$HOME/.local/share/../bin/env"
eval "$(zoxide init bash)"

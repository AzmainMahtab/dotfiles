#!/usr/bin/env bash
# Wofi wallpaper picker with thumbnails, using the existing wofi theme (~/.config/wofi).

set -euo pipefail

wall_dir="$HOME/Pictures/Wallpapers"
cache_dir="$HOME/.cache/wallpaper-picker"
wofi_conf="$HOME/.config/wofi/wallpaper-picker-config"
wofi_style="$HOME/.config/wofi/wallpaper-picker.css"
hyprpaper_conf="$HOME/.config/hypr/hyprpaper.conf"
thumb_size=200

mkdir -p "$cache_dir"

shopt -s nullglob nocaseglob
wallpapers=("$wall_dir"/*.jpg "$wall_dir"/*.jpeg "$wall_dir"/*.png "$wall_dir"/*.webp)
shopt -u nullglob nocaseglob

if [ ${#wallpapers[@]} -eq 0 ]; then
    notify-send "Wallpaper Picker" "No wallpapers found in $wall_dir" 2>/dev/null || true
    exit 1
fi

# Generate or reuse a PNG thumbnail for a wallpaper.
thumb_for() {
    local src="$1"
    local name hash thumb
    name="$(basename "$src")"
    hash="$(printf '%s' "$src" | md5sum | cut -d' ' -f1)"
    thumb="$cache_dir/${hash}_${name}.png"
    if [ ! -f "$thumb" ] || [ "$src" -nt "$thumb" ]; then
        if command -v magick >/dev/null 2>&1; then
            magick "$src" -resize "${thumb_size}x${thumb_size}>" "$thumb" 2>/dev/null || true
        elif command -v convert >/dev/null 2>&1; then
            convert "$src" -resize "${thumb_size}x${thumb_size}>" "$thumb" 2>/dev/null || true
        fi
    fi
    printf '%s' "$thumb"
}

menu_entries() {
    for wall in "${wallpapers[@]}"; do
        local thumb
        thumb="$(thumb_for "$wall")"
        if [ -f "$thumb" ]; then
            printf '%s:img:%s\n' "$(basename "$wall")" "$thumb"
        else
            printf '%s\n' "$(basename "$wall")"
        fi
    done
}

selected_name=$(menu_entries | wofi --dmenu \
    --allow-images \
    --conf "$wofi_conf" \
    --style "$wofi_style")

[ -z "$selected_name" ] && exit 0

selected_path="$wall_dir/$selected_name"

hyprctl hyprpaper wallpaper "eDP-1,$selected_path" >/dev/null 2>&1

cat > "$hyprpaper_conf" <<EOF
splash = false
ipc = on

wallpaper {
    monitor = eDP-1
    path = $selected_path
}
EOF

notify-send "Wallpaper" "Set to $selected_name" 2>/dev/null || true

#!/usr/bin/env python3
"""Render a colour theme into ~/.config/theme-active and reload the desktop.

Usage: theme-apply <theme>    (theme = a file in ~/.config/themes/palettes)
       theme-apply            (re-apply the current theme, default catppuccin)
       theme-apply --list     (print "<theme>\\t<Display name>" per line)
       theme-apply --wallpaper-dir   (folder of the current theme's wallpapers)

Palettes (key=value) and templates ({{key}}, {{key.hex}}, {{key.rgb}}) live in
~/.config/themes. Output goes to ~/.config/theme-active, which is not tracked.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
SRC = HOME / ".config/themes"
OUT = HOME / ".config/theme-active"
DEFAULT = "catppuccin"


def load_palette(name):
    path = SRC / "palettes" / f"{name}.conf"
    if not path.is_file():
        sys.exit(f"theme-apply: unknown theme '{name}' (no {path})")
    pal = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            pal[k.strip()] = v.strip()
    return pal


def render(text, pal):
    def sub(m):
        key, _, mod = m.group(1).partition(".")
        if key not in pal:
            sys.exit(f"theme-apply: template uses undefined key '{key}'")
        val = pal[key]
        if mod == "hex":
            return val.lstrip("#")
        if mod == "rgb":
            h = val.lstrip("#")
            return ", ".join(str(int(h[i:i + 2], 16)) for i in (0, 2, 4))
        return val

    return re.sub(r"\{\{\s*([\w.]+)\s*\}\}", sub, text)


def list_themes():
    for f in sorted((SRC / "palettes").glob("*.conf")):
        print(f"{f.stem}\t{load_palette(f.stem).get('name', f.stem)}")


def current_name():
    cur = OUT / "current"
    return cur.read_text().strip() if cur.is_file() else DEFAULT


def wallpaper_dir(pal):
    return HOME / "Pictures/Wallpapers" / pal.get("wallpaper_dir", "")


def pick_wallpaper(name, pal):
    """The wallpaper last used with this theme, else the first image in its folder."""
    remembered = OUT / f"wallpaper-{name}"
    if remembered.is_file():
        path = Path(remembered.read_text().strip())
        if path.is_file():
            return path
    images = sorted(p for p in wallpaper_dir(pal).glob("*")
                    if p.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp"))
    return images[0] if images else None


def sh(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        return list_themes()

    if len(sys.argv) > 1 and sys.argv[1] == "--wallpaper-dir":
        print(wallpaper_dir(load_palette(current_name())))
        return

    current = OUT / "current"
    name = sys.argv[1] if len(sys.argv) > 1 else current_name()
    pal = load_palette(name)
    pal.setdefault("name", name)

    OUT.mkdir(parents=True, exist_ok=True)
    for tpl in sorted((SRC / "templates").iterdir()):
        (OUT / tpl.name).write_text(render(tpl.read_text(), pal))

    # GTK CSS (waybar, wofi) gets every colour as @th_<key>.
    css = [f"@define-color th_{k} {v};" for k, v in pal.items() if v.startswith("#")]
    (OUT / "colors.css").write_text("\n".join(css) + "\n")
    (OUT / "nvim-colorscheme").write_text(pal.get("nvim_colorscheme", "") + "\n")
    current.write_text(name + "\n")

    # dunst reads drop-ins from dunstrc.d; keep it pointing at the generated file.
    dropin = HOME / ".config/dunst/dunstrc.d"
    dropin.mkdir(parents=True, exist_ok=True)
    link = dropin / "50-theme.conf"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(OUT / "dunst.conf")

    # GTK apps (nemo, ...) follow gsettings; GTK_THEME is deliberately not set.
    gtk = pal.get("gtk_theme")
    if gtk and (Path("/usr/share/themes") / gtk).is_dir():
        sh("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk)
        sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark")

    wall = pick_wallpaper(name, pal)
    if wall:
        sh(str(HOME / ".local/bin/set-wallpaper"), str(wall))

    # Reload whatever is running; everything else picks the theme up at next launch.
    sh("hyprctl", "reload")
    sh("pkill", "-SIGUSR2", "-x", "waybar")
    sh("pkill", "-SIGUSR1", "-x", "kitty")
    sh("dunstctl", "reload")
    sh("notify-send", "-a", "Theme", "Theme", f"Switched to {pal['name']}")


if __name__ == "__main__":
    main()

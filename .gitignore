# systemctl --user enable writes wants/ symlinks into ~/.config/systemd/user,
# which is a symlink into this repo. Keep the generated units out of git.
config/systemd/user/*.wants/

# theme-apply points a generated drop-in into this repo-tracked directory.
config/dunst/dunstrc.d/
config/gtk-3.0/gtk.css
config/gtk-4.0/gtk.css
__pycache__/
